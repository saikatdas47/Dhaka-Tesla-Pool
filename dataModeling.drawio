<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram name="01 Collections and references" id="collection-erd">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="e-title" value="DATA MODEL — COLLECTIONS, TYPES AND REFERENCES" style="text;html=1;align=left;fontSize=28;fontStyle=1;fontColor=#173A3B;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="e-passenger" value="PASSENGER&#xa;_id: ObjectId [PK]&#xa;name: String [required]&#xa;username: String [unique per role]&#xa;email: String [unique per role]&#xa;phone: String&#xa;passwordHash, refreshTokenHash: String [private]&#xa;emailVerifiedAt: Date?&#xa;avatarUrl, avatarPublicId: String?&#xa;pendingAvatarFilename: String?&#xa;isDemo: Boolean; createdAt, updatedAt: Date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#5F91B7;fontColor=#1C445E;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="140" width="420" height="410" as="geometry"/></mxCell>
        <mxCell id="e-ride" value="RIDE REQUEST&#xa;_id: ObjectId [PK]&#xa;passenger: ObjectId → Passenger [FK]&#xa;pool: ObjectId → Pool? [FK]&#xa;passengerName: String snapshot&#xa;pickupArea, destinationArea: String&#xa;seats, approximateKm: Number&#xa;soloFarePaisa, pooledFarePaisa: Number&#xa;fareRule: {baseFarePaisa, perKmPaisa, sharedDiscountPercent}&#xa;finalFarePaisa: Number?&#xa;paymentMethod, paymentStatus: enum?&#xa;paidAt: Date?; status: enum&#xa;history[]: {status, at}; timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E4;strokeColor=#D8A05A;fontColor=#664722;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="625" y="135" width="495" height="535" as="geometry"/></mxCell>
        <mxCell id="e-pool" value="POOL&#xa;_id: ObjectId [PK]&#xa;driver: ObjectId → Driver [FK]&#xa;pickupArea, firstDestinationArea: String&#xa;capacity: Number [2–4]&#xa;occupiedSeats: Number [0–capacity]&#xa;vehicle + driver snapshots: Strings&#xa;members[]: {request FK, passenger FK,&#xa;  passengerName, seats, destinationArea}&#xa;status: enum&#xa;history[]: {status, at, request?, name?, seats?}&#xa;createdAt, updatedAt: Date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5ED;strokeColor=#69A479;fontColor=#244F37;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1300" y="135" width="455" height="535" as="geometry"/></mxCell>
        <mxCell id="e-driver" value="DRIVER&#xa;_id: ObjectId [PK]&#xa;name, username, email, phone: String&#xa;passwordHash, refreshTokenHash: private&#xa;licenseNumber: String; licenseExpiry: Date&#xa;vehicleModel, vehicleRegistrationNumber: String&#xa;vehicleColor: String; passengerSeats: Number [2–4]&#xa;serviceArea ≠ currentArea: String&#xa;availability, verificationStatus: enum&#xa;verificationHistory[]: {status, at, by}&#xa;locationSource, locationUpdatedAt; timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#5F91B7;fontColor=#1C445E;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1300" y="745" width="455" height="405" as="geometry"/></mxCell>
        <mxCell id="e-otp" value="EMAIL OTP&#xa;_id: ObjectId [PK]&#xa;(role, email): unique pair&#xa;otpHash, registrationTokenHash: String?&#xa;sentAt, expiresAt: Date&#xa;attempts: Number&#xa;TTL index on expiresAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#9479BB;fontColor=#513F71;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="780" width="420" height="245" as="geometry"/></mxCell>
        <mxCell id="e-fare" value="FARE SETTINGS&#xa;_id: &quot;current&quot; [singleton PK]&#xa;baseFarePaisa: integer&#xa;perKmPaisa: integer&#xa;sharedDiscountPercent: integer 0–100&#xa;createdAt, updatedAt: Date&#xa;Rates copied to RideRequest at booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E4;strokeColor=#D8A05A;fontColor=#664722;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="625" y="800" width="495" height="230" as="geometry"/></mxCell>
        <mxCell id="e-p-r" value="1 → many requests" edge="1" source="e-passenger" target="e-ride" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#5B7883;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-r-pool" value="many requests → 0..1 pool each" edge="1" source="e-ride" target="e-pool" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#5B7883;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-pool-driver" value="many pools → 1 driver" edge="1" source="e-pool" target="e-driver" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#5B7883;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-fare-ride" value="snapshot rate at booking" edge="1" source="e-fare" target="e-ride" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#5B7883;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="02 Embedded structures and rules" id="embedded-model">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c-title" value="DATA MODEL — EMBEDDED DOCUMENTS AND INVARIANTS" style="text;html=1;align=left;fontSize=28;fontStyle=1;fontColor=#173A3B;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="c-farerule" value="RideRequest.fareRule&#xa;baseFarePaisa: Number&#xa;perKmPaisa: Number&#xa;sharedDiscountPercent: Number&#xa;Copied once when booking; old rides never reprice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E4;strokeColor=#D8A05A;fontColor=#664722;fontSize=16;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="155" width="470" height="225" as="geometry"/></mxCell>
        <mxCell id="c-rideevents" value="RideRequest.history[]&#xa;status: String&#xa;at: Date&#xa;Includes lifecycle + PAYMENT_DUE / PAYMENT_PAID events.&#xa;Passenger sees only own timeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#5F91B7;fontColor=#1C445E;fontSize=16;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="565" y="155" width="470" height="225" as="geometry"/></mxCell>
        <mxCell id="c-members" value="Pool.members[]&#xa;request: ObjectId → RideRequest&#xa;passenger: ObjectId → Passenger&#xa;passengerName: String snapshot&#xa;seats: Number; destinationArea: String&#xa;Current members; at most 2–4 seats total." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5ED;strokeColor=#69A479;fontColor=#244F37;fontSize=16;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1085" y="155" width="470" height="225" as="geometry"/></mxCell>
        <mxCell id="c-verify" value="Driver.verificationHistory[]&#xa;status: pending / approved / rejected / unverified&#xa;at: Date; by: String&#xa;Admin decision history; separate from trip history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#9479BB;fontColor=#513F71;fontSize=16;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="455" width="470" height="210" as="geometry"/></mxCell>
        <mxCell id="c-poolevents" value="Pool.history[]&#xa;status: String; at: Date&#xa;request: ObjectId?; passengerName: String?&#xa;seats: Number?&#xa;Tracks member changes and pool lifecycle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5ED;strokeColor=#69A479;fontColor=#244F37;fontSize=16;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="565" y="455" width="470" height="210" as="geometry"/></mxCell>
        <mxCell id="c-indexes" value="DATABASE GUARANTEES&#xa;RideRequest: partial unique passenger for active statuses&#xa;Pool: partial unique driver for active statuses&#xa;EmailOtp: unique(role,email) + TTL(expiresAt)&#xa;Passenger/Driver: role-local unique identity fields&#xa;Seat claim: conditional atomic update + transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8F7;strokeColor=#B8C9C7;fontColor=#35525A;fontSize=15;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1085" y="455" width="470" height="250" as="geometry"/></mxCell>
        <mxCell id="c-privacy" value="ACCESS RULE&#xa;Passenger reads RideRequest only when passenger = authenticated ID. Driver reads assigned Pool. Admin sees Passenger account projection, NOT Passenger ride history. Password hashes, token hashes and Cloudinary IDs never enter public responses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8F7;strokeColor=#B8C9C7;fontColor=#35525A;fontSize=16;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="755" width="1510" height="155" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
