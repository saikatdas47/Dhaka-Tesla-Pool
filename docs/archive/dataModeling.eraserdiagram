// FINAL MVP OVERVIEW: 6 MongoDB collections, not 4 or 5.
// Core: Passenger, Driver, RideRequest, Pool.
// Support: EmailOtp, FareSettings. No Admin collection in current code.
// For every field and index, see dataModeling.detailed.eraserdiagram.

Passenger [color: blue] {
  _id ObjectId pk
  name string
  username string unique_partial
  email string unique
  phone string
  avatarUrl string
}

Driver [color: green] {
  _id ObjectId pk
  name string
  username string unique
  licenseNumber string unique
  passengerSeats number min2_max4
  currentArea string
  availability string
  verificationStatus string
}

RideRequest [color: orange] {
  _id ObjectId pk
  passenger ObjectId fk
  pool ObjectId optional_fk
  pickupArea string
  destinationArea string
  seats number min1_max4
  soloFarePaisa number
  pooledFarePaisa number
  status string
}

Pool [color: green] {
  _id ObjectId pk
  driver ObjectId fk
  capacity number min2_max4
  occupiedSeats number
  members array embedded
  status string
}

EmailOtp [color: purple] {
  _id ObjectId pk
  role string
  email string
  expiresAt date ttl
}

FareSettings [color: purple] {
  _id string pk_current
  baseFarePaisa number
  perKmPaisa number
  sharedDiscountPercent number
}

RideRequest.passenger > Passenger._id
RideRequest.pool > Pool._id
Pool.driver > Driver._id
Pool <> Passenger

// Pool <> Passenger means membership via embedded Pool.members[].
// EmailOtp is keyed by (role,email), not a stored account ObjectId reference.
// FareSettings values are COPIED into each new RideRequest.fareRule; no FK exists.
// Old rides keep their own fare snapshots after Admin changes rates.
