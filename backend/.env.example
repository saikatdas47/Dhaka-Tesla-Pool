# Copy to backend/.env and replace placeholders locally. Never commit real credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DB_NAME=dhaka_tesla_pool
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_unique_random_secret_of_at_least_32_bytes
COOKIE_SECURE=false
