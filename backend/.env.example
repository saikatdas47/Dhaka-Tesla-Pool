MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/
MONGODB_TEST_URI=mongodb+srv://USERNAME:PASSWORD@TEST_CLUSTER_HOST/

PORT=8000


AccessTokenSecret=dummy-access-token-secret
RefreshTokenSecret=dummy-refresh-token-secret
AccessTokenExpiresIn=15m
RefreshTokenExpiresIn=7d
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes



CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


EMAIL_USER=your_email@example.com
EMAIL_APP_PASSWORD=your_email_app_password
EMAIL_FROM_NAME=Email OTP Demo

OTP_SECRET=replace_with_a_long_random_otp_secret
ENABLE_DEMO_ACCOUNTS=true
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace_with_a_random_password_at_least_16_characters
